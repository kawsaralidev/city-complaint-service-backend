model AuditLog {
  id        String   @id @default(uuid())

  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])

  @@map("audit_logs")
}