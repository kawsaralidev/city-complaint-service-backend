model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  baseFee     Decimal  @db.Decimal(10, 2)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@index([isActive])
  @@map("services")
}